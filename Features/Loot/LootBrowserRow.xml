<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/AmerithPrime/BlizzardInterfaceResources/live/Resources/FrameXML/UI.xsd">

    <Frame name="YippYappLootRowTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="1">
                <Texture parentKey="bg" setAllPoints="true"/>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="2">
                <Texture parentKey="dungBg" alpha="0.5">
                    <Size x="325" y="114"/>
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </Texture>
                <MaskTexture parentKey="dungBgMask" atlas="perks-list-mask" useAtlasSize="true"
                             alphaMode="BLEND"
                             vWrapMode="CLAMPTOBLACKADDITIVE"
                             hWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="LEFT" x="-286"/>
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="dungBg"/>
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
        </Layers>
    </Frame>

</Ui>
