## Interface: 120100, 120007
## Title: YippYapp Helper
## Notes: Gear upgrade advisor, Mythic+ helper, ready-check window, loot browser and more
## Author: vbaustad
## Version: 3.1.1
## SavedVariables: YippYappHelperDB
## OptionalDeps: LibDBIcon-1.0, LibDataBroker-1.1
## IconTexture: Interface\AddOns\YippYappHelper\Media\YippYappHelper

## X-Curse-Project-ID: 1488843
## X-Website: https://github.com/vbaustad/YippYappHelper

# ─── Libraries ────────────────────────────────────────────
Libs\LibStub\LibStub.lua
Libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
Libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
Libs\LibDBIcon-1.0\LibDBIcon-1.0.lua

# LibEditMode registers our movable frames as real Edit Mode systems, so
# they get Blizzard's own selection outlines and settings dialogs.
# Core/EditMode.lua falls back to hand-drawn boxes if this is missing.
Libs\LibEditMode\embed.xml

# ─── Core ─────────────────────────────────────────────────
Core\YippYappHelper.lua
Core\Data.lua
Core\Core.lua

# The shared situation window. Loads ahead of every feature because the
# three panels that live in it -- ready check, dungeon utility notes and
# the after-key summary -- register themselves against it as they build,
# and the ready-check window builds its frame at file scope.
Core\Hud.lua

# Shared right-click menu for items. Loaded with Core so every
# page can raise the same one; the actions it offers come from
# whichever feature files happen to be present.
Core\ItemMenu.lua

# Reads the player's own currency list so the rail lists what the
# game lists. Only touches ns.CRESTS at call time, so it does not
# need Features\Gear\Crests.lua loaded ahead of it.
Core\Currency.lua

# The shell contract: page registry, region sizes, and the rule
# that pages never draw their own chrome. Skin providers supply
# the chrome instead, so two looks share one layout.
Core\Widgets.lua
Core\Shell.lua
Core\Skin.lua
Core\SkinBlizzlike.lua
Core\ShellFrame.lua
Core\ShellHome.lua

# Crests is referenced by Core\UI.lua at load-time, so load it first.
Features\Gear\Crests.lua
Features\Gear\Recommend.lua

# Stat priority and best-in-slot per spec, generated from Wowhead's class
# guides (see Tools/scrape_class_guides.py). Pure data — nothing reads it
# yet, but it loads here so a UI can.
Features\Gear\ClassGuideData.lua

# Reads the priority half of that data: which build you are in, and which
# stat it wants first. Both the Best in Slot page and the shell's
# character column ask it, so it loads ahead of either. Core\ShellFrame.lua
# is above this and calls in at refresh time rather than at load time.
Features\Gear\StatPriority.lua

Core\UI.lua

# The shell's Gear Upgrades page. Registers itself rather than being
# adapted, so it loads after everything it reads: Core\Shell.lua for the
# registry, Core\Core.lua for the slots, and Features\Gear\Recommend.lua
# for the recommendations.
Features\Gear\GearPage.lua

# ─── Features ─────────────────────────────────────────────
Features\Raid\SpecMeta.lua
Features\Raid\RaidInspect.lua
Features\Raid\ReadyCheck.lua
Features\Raid\BattleResTimer.lua
Features\Raid\RaidUI.lua

# The Boss Guide, and the arena that tests whether you read it.
#
# Data first, then the Encounter Journal pass that corrects the names in
# it, then the trainer, then the view -- RaidGuideUI reads all three.
# RaidUI.lua above only reaches for ns.RaidGuideUI when a player opens
# the sub-tab, so it does not need any of this at its own load time.
Features\Raid\RaidGuideData.lua
Features\Raid\RaidGuideEJ.lua
Features\Raid\RaidTrainerScenarios.lua
Features\Raid\RaidTrainer.lua
Features\Raid\RaidGuideUI.lua

Features\Progression\ProgressionData.lua
Features\Progression\ProgressionUI.lua

Features\Loot\LootBrowserData.lua
Features\Loot\LootBrowserRow.xml
Features\Loot\LootBrowserUI.lua

Features\Consumables\ConsumablesData.lua
Features\Consumables\ConsumablesUI.lua

# TrinketData is generated from bloodmallet.com (see Tools/). Healers
# come from QE Live instead -- bloodmallet sims damage only -- and merge
# into the same table, so the healer file has to load after it.
Features\Trinkets\TrinketData.lua
Features\Trinkets\TrinketDataHealer.lua
Features\Trinkets\TrinketIndex.lua
Features\Trinkets\TrinketUI.lua

# Registers the remaining pages against the shell contract.
# Last, because it adapts frames the feature files create.
Core\ShellPages.lua

# Reads Features\Gear\ClassGuideData.lua, loaded above.
Features\Gear\BisUI.lua

Features\MythicPlus\MythicPlusData.lua
Features\MythicPlus\MythicPlusUI.lua
Features\MythicPlus\CompletionPopup.lua
Features\MythicPlus\UtilityData.lua
Features\MythicPlus\UtilityAdvisor.lua

Features\Teleports\TeleportUI.lua

Features\Interrupts\InterruptsSettings.lua
Features\Interrupts\InterruptsData.lua
Features\Interrupts\InterruptsUI.lua

# ─── Integrations (must load after Features) ──────────────
# Planner data is consumed by AppFrame's home dashboard, so it must load
# before AppFrame.lua. Kept under Features for locality.
Features\Fun\FunStats.lua
Features\Fun\Snark.lua
Features\Fun\Advisor.lua

Features\Delves\DelvesData.lua
Features\Delves\DelvesUI.lua
Features\Planner\WeeklyChecklist.lua
Features\Planner\PlannerData.lua
Core\AppFrame.lua

# Edit Mode integration, then the Blizzard settings registration. Both
# load after every feature they touch so their getters/setters can reach
# them, and both register at PLAYER_LOGIN.
Core\EditMode.lua
Core\EditModeLib.lua
Core\BlizzSettings.lua
Integrations\Dashboard.lua
Integrations\PVETab.lua
Integrations\MinimapButton.lua
